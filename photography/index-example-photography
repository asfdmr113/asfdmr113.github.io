<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="gallery">
    <div class="group relative overflow-hidden bg-gray-100 aspect-[4/5] rounded-sm cursor-zoom-in lightbox-trigger" data-full="../assets/images/photography/photo1.webp">
        <img src="../assets/images/photography/photo1.webp" alt="Morning in Karawang" loading="lazy" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
        <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6">
            <p class="text-white text-[10px] uppercase tracking-widest">View Fullscreen</p>
        </div>
    </div>
</div>

<div id="lightbox" class="fixed inset-0 z-[100] bg-white/95 backdrop-blur-sm hidden flex-col items-center justify-center p-4 md:p-10 transition-all duration-300">
    <button id="close-lightbox" class="absolute top-8 right-8 text-black hover:rotate-90 transition-transform">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M6 18L18 6M6 6l12 12" />
        </svg>
    </button>

    <img id="lightbox-img" src="" class="max-w-full max-h-[85vh] object-contain shadow-2xl">

    <p id="lightbox-caption" class="mt-6 text-[10px] uppercase tracking-[0.2em] text-gray-500 font-medium"></p>
</div>